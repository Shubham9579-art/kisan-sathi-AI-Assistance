# KisanSathi AI Environment Configuration
# Core
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local hackathon demo passcode only. Disabled automatically in production.
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_OTP=246810

# Database (defaults to local SQLite in backend root)
DATABASE_URL=sqlite:///./kisansathi.db

# Optional AI Integration (leave empty for deterministic offline demo mode)
# AI_PROVIDER=gemini # or openai / mock
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional Weather Integration (leave empty for labelled realistic demo weather)
# OPENWEATHER_API_KEY=
