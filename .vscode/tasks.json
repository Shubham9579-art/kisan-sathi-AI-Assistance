{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-push saved changes to GitHub",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\auto-push.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "auto-push",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[auto-push\\] Watching",
          "endsPattern": "^\\[auto-push\\] Ready$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
